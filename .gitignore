# Virtual environment
.venv/
venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Data: large files and licensing; keep only the folder placeholders
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained models: ignore all except the two the demo app loads
models/*
!models/.gitkeep
!models/tfidf_vectorizer.joblib
!models/logreg_classifier.joblib

# Secrets
.env
*.key

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
# Build metadata
*.egg-info/
